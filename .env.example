# TFT Stats : configuration locale.
# Copie ce fichier en « .env » et remplis-le. Le fichier .env ne doit jamais être publié.
# Les lignes qui commencent par # sont ignorées.

# Clé de développement Riot (https://developer.riotgames.com). Elle expire après 24 h.
RIOT_API_KEY=

# Ton Riot ID, au format Nom#TAG. Sert à repérer tes parties et tes résultats.
RIOT_ID=

# Plateforme et région (valeurs par défaut : euw1 et europe).
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Rangs collectés puis analysés, séparés par des virgules (ex. SILVER:I,GOLD:IV,MASTER:I).
# Vide ou TOUS = tout le ladder, de Fer IV à Challenger. La collecte lit le classement complet
# de chaque rang, page par page ; la file de jobs reprend là où elle s'est arrêtée.
RANGS=

# Budget de requêtes Riot par heure pour la collecte (défaut 2700, 0 = sans limite).
# Une clé de développement permet 100 requêtes toutes les 2 minutes, soit 3 000 par heure.
REQUETES_HEURE=2700

# Parties par collecte manuelle (défaut 800) et par collecte automatique (défaut 200).
PARTIES_PAR_COLLECTE=800
PARTIES_AUTO=200

# Collecte automatique toutes les AUTO_MIN minutes (défaut 30).
# AUTO_START=0 : pas de collecte au lancement.
AUTO_MIN=30
AUTO_START=1

# Nombre de jours pris en compte dans la collecte (défaut 14).
JOURS=14

# 1 = n'analyser que le patch en cours (d'après data/patchs.json) au lieu des JOURS derniers jours.
# Riot ne donne plus le patch des parties : peu de parties les premiers jours d'un patch. Défaut : 0.
PATCH_SEUL=0

# Récap après chaque partie classée. 0 pour le désactiver.
RECAP_FENETRE=1

# Overlay.
# OVERLAY_AUTO=0 : pas d'ouverture automatique.
# OVERLAY_COMPACT=1 : vue réduite au bandeau.
# OVERLAY_FORME=0 : désactive le style sans barre de titre.
# OVERLAY_ALPHA : transparence de 90 à 255 (défaut 170).
OVERLAY_AUTO=1
OVERLAY_COMPACT=0
OVERLAY_FORME=1
OVERLAY_ALPHA=170

# Repérage des autres joueurs au début d'une partie. 0 pour le désactiver.
LOBBY_AUTO=1

# Accès depuis le téléphone, sur le même Wi-Fi.
# MOBILE=1 pour l'activer, avec un code PIN de 4 à 8 chiffres.
MOBILE=0
MOBILE_PIN=
